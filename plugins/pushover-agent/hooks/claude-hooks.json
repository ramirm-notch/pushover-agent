{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUSHOVER_API_TOKEN=\"${PUSHOVER_API_TOKEN_CC:-$PUSHOVER_API_TOKEN}\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/pushover-notify.mjs\" --host \"Claude Code\"",
            "timeout": 15,
            "async": true,
            "statusMessage": "Sending Pushover notification..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "PUSHOVER_API_TOKEN=\"${PUSHOVER_API_TOKEN_CC:-$PUSHOVER_API_TOKEN}\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/pushover-notify.mjs\" --host \"Claude Code\"",
            "timeout": 15,
            "async": true,
            "statusMessage": "Sending Pushover notification..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUSHOVER_API_TOKEN=\"${PUSHOVER_API_TOKEN_CC:-$PUSHOVER_API_TOKEN}\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/pushover-notify.mjs\" --host \"Claude Code\"",
            "timeout": 15,
            "async": true,
            "statusMessage": "Sending Pushover notification..."
          }
        ]
      }
    ]
  }
}
